---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}{% if item.page_kind == 'home' or item.page_kind == 'article' %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>{% if item.date %}
    <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
{% endif %}{% endfor %}
</urlset>
